# App Settings
APP_NAME=HYBO-Assistant
DEBUG=False
PORT=8000
HOST=0.0.0.0

# AWS Settings (Optional: Leave blank or omit for deployment without Bedrock/AWS)
# Providing valid AWS credentials will automatically enable Bedrock AI features.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# AI Settings
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
MAX_TOKENS=2048
TEMPERATURE=0.2

# Supabase Database & Auth Settings
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Frontend URL (for CORS allowance)
FRONTEND_URL=http://localhost:3000

