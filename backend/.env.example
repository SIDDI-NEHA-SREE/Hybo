# App Settings
APP_NAME=HYBO-Assistant
DEBUG=False
PORT=8000
HOST=0.0.0.0

# AWS Settings (Optional: Leave blank or omit for deployment without Bedrock/AWS)
# Providing valid AWS credentials will automatically enable Bedrock AI features.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# AI Settings
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
MAX_TOKENS=2048
TEMPERATURE=0.2

# Twilio Configuration (For Phone Number Login via SMS / Verify)
# If left blank, the app runs in Dev Fallback Mode (OTP printed to server logs and returned in dev response).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# JWT Authentication
JWT_SECRET_KEY=hybo-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
OTP_EXPIRE_MINUTES=5
